// egress.capa
//
// THE audited egress. This module is the single point where regulated
// payroll data is allowed to leave the program, and it is where the two
// structural layers of the guarantee compose.
//
// LAYER 1 - FLOW CONFINEMENT (information-flow control, @secret).
//   ``export_to_bureau`` opts into @strict_ifc, so any @secret value that
//   reaches a sink (here Net.post's URL and body arguments) WITHOUT an
//   audited declassify is a HARD COMPILE ERROR, not a warning. The payroll
//   payload is @secret (it interpolates name / national_id / iban /
//   gross_salary), so it can only reach Net.post through the ONE
//   ``declassify`` below, whose reason names the DPA with the bureau.
//   There is no second egress and no bypass; the compiler proves it.
//
// LAYER 2 - HOST CONFINEMENT (Net attenuation + WASI grant).
//   The function holds a Net that it immediately narrows with
//   ``restrict_to(approved_host)``. At run time (the default backend) that
//   attenuation refuses any host other than the approved one before a
//   single byte hits the socket. Under ``--wasi`` the approved host is
//   operator-declared (``--allow-host``) and is the ONLY host the
//   component can reach: 169.254.169.254 and every other endpoint are
//   denied by construction. offhost_export.capa demonstrates the denial.
//
// Together: the secret leaves at exactly ONE audited point (layer 1), and
// that point can reach exactly ONE approved host (layer 2).

import domain
import payload

// Export the payroll batch to the approved bureau.
//
// ``approved_host`` is the operator-configured host (read from config, a
// dynamic value). ``records`` carry the @secret payroll fields.
//
// @strict_ifc turns an unaudited secret-to-sink flow into a compile error.
@strict_ifc()
pub fun export_to_bureau(net: Net, approved_host: String, records: List<PayrollRecord>) -> Result<String, ExportError>
    // Layer 2: attenuate Net to the single approved bureau host. Every
    // subsequent request through ``bureau`` is checked against this host.
    let bureau = net.restrict_to(approved_host)

    // The endpoint URL. The host is the operator-configured value, so the
    // whole URL is dynamic: under --wasi this is exactly what forces the
    // operator to declare --allow-host <approved_host> (fail-closed).
    let url = "https://${approved_host}/v1/payroll/export"

    // Build the payload from the @secret records. ``secret_payload`` carries
    // the @secret label because it embeds regulated fields.
    let secret_payload = build_payload(records)

    // Layer 1: the SINGLE audited egress. declassify is the one bridge out
    // of the secret domain, and its reason names the data processing
    // agreement that authorises this specific disclosure to this specific
    // processor. Remove it and @strict_ifc rejects the build.
    let authorised_payload = declassify(
        secret_payload,
        reason: "DPA-2026-0417, Art. 28 GDPR processor agreement with the approved payroll bureau: the regulated fields (name, national id, IBAN, gross salary) are disclosed to the contracted processor for the sole purpose of running payroll, over the operator-approved endpoint and no other"
    )

    // Egress. The URL host is public; the body is the declassified payload.
    return match bureau.post(url, authorised_payload)
        Ok(resp) -> Ok(resp)
        Err(e)   -> Err(Egress("${e}"))
